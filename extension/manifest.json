{
  "manifest_version": 3,
  "name": "coreText",
  "version": "0.1.0",
  "description": "Ctrl+F by meaning: find passages on the page with Gemini.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "coreText"
  },
  "permissions": ["activeTab", "scripting", "clipboardRead"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://www.youtube.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open coreText popup"
    }
  }
}
