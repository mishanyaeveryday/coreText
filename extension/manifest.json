{
  "manifest_version": 3,
  "name": "coreText",
  "version": "0.1.0",
  "description": "Print the current page to the browser console.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "coreText"
  },
  "permissions": ["activeTab", "scripting", "clipboardRead"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open coreText popup"
    }
  }
}
